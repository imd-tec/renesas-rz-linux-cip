/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

&{/} {
	hdmi-out {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_out: endpoint {
				remote-endpoint = <&lt8912b_out>;
			};
		};
	};
};

&disp_reg {
	regulator-always-on;
};

&dsi_adaptor_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	lt8912b: hdmi@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		reset-gpios = <&pinctrl RZG2L_GPIO(7, 2) GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt8912b_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912b_out: endpoint {
					remote-endpoint = <&hdmi_con_out>;
				};
			};
		};
	};
};

&du {
	status = "okay";
};

&dsi0 {
	status = "okay";
	ports {
		port@1 {
			dsi0_out: endpoint {
				remote-endpoint = <&lt8912b_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};
