// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * Common device tree for the IMDT Renesas V2N or V2H SBCs
 *
 * Copyright (C) 2022 Renesas Electronics Corp.
 * Copyright (C) 2024 IMD Technologies Ltd.
 */

/ {
	chosen {
		bootargs = "ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

	gpio-keys {
		compatible = "gpio-keys";

		nmi {
			interrupt-parent = <&icu>;
			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			linux,code = <0>;
			label = "NMI";
			wakeup-source;
		};
	};

	reg_1p8v: regulator0 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator1 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_audio_3v3: regulator2 {
		compatible = "regulator-fixed";
		regulator-name = "audio-3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_audio_1v8: regulator3 {
		compatible = "regulator-fixed";
		regulator-name = "audio-1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_1p8v_sdio: regulator4 {
		compatible = "regulator-fixed";
		regulator-name = "sdio-fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};
	reg_2p8v: regulator5 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-2.8V";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-boot-on;
		regulator-always-on;
	};
	reg_1p5v: regulator6 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-1.5V";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vccq_sdhi0: regulator-vccq-sdhi0 {
		compatible = "regulator-gpio";

		regulator-name = "SDHI0 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		// LDO_SEL1 input on RAA215300 PMIC
		gpios = <&pinctrl RZG2L_GPIO(10, 0) GPIO_ACTIVE_HIGH>;

		gpios-states = <0>;
		states = <3300000 0 1800000 1>;
	};

	vqmmc_sdhi1: regulator-vccq-sdhi1 {
		compatible = "regulator-gpio";

		regulator-name = "SDHI1 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		// LDO_SEL2 input on RAA215300 PMIC
		gpios = <&pinctrl RZG2L_GPIO(10, 2) GPIO_ACTIVE_HIGH>;

		gpios-states = <0>;
		states = <3300000 0 1800000 1>;
	};

	wlan_en_pmic: wlan-en-1-8v {
		compatible = "regulator-fixed";

		regulator-name = "wlan-pmic-en-regulator";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&pinctrl RZG2L_GPIO(7, 5) GPIO_ACTIVE_HIGH>;

		startup-delay-us = <100000>;
		enable-active-high;
	};
	// Regulator for the M2 Key M slot
	VM2M_3V3: VM2M_en-3-3v {
		compatible = "regulator-fixed";

		regulator-name = "V2M_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&m2_gpio 5 GPIO_ACTIVE_HIGH>;
		/* Measured to take 0.5ms using a scope, set to 5ms */
		/* so there's a safety factor to ensure the regulator is stable */
		startup-delay-us = <5000>;
		enable-active-high;
	};

	clk_ext_camera: clk_ext_camera {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	/* input to the 5L35023B */
	x1_clk: x1-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	tlv320_xtal: tlv320_xtal {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12288000>;
	};

	snd_rzv2h: sound {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "simple-audio-card";
		simple-audio-card,name = "rsnd_rzv2h";
		status = "okay";
		simple-audio-card,widgets =
			"Microphone", "Microphone Jack",
			"Headphone", "Headphone Jack";
		simple-audio-card,routing =
			"Headphone Jack", "HPLOUT",
			"Headphone Jack", "HPROUT",
			"MIC2R", "Microphone Jack",
			"Microphone Jack", "Mic Bias";

		ssi_link: simple-audio-card,dai-link@0 {
			format = "i2s";
			reg = <0>;
			bitclock-master = <&cpu_dai0>;
			frame-master = <&cpu_dai0>;
			mclk-fs = <256>;

			cpu_dai0: cpu {
				sound-dai = <&rcar_sound>;
			};

			codec {
				sound-dai = <&tlv320aic3x>;
			};
		};
	};

	dsi_adaptor_i2c: dsi_adaptor_i2c {
		compatible = "i2c-gpio";
		sda-gpios = <&pinctrl RZG2L_GPIO(2, 0) GPIO_ACTIVE_HIGH>;
		scl-gpios = <&pinctrl RZG2L_GPIO(2, 1) GPIO_ACTIVE_HIGH>;
		i2c-gpio,delay-us = <2>;    /* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};
};

&audio_clka {
	/* output from 5L35023B */
	clock-frequency = <22579200>;
};

&pinctrl {
	can1_pins: can1 {
		pinmux = <RZG2L_PORT_PINMUX(8, 2, 5)>, /* TX */
				<RZG2L_PORT_PINMUX(8, 3, 5)>; /* RX */
	};

	scif0_pins: scif0 {
		pins =  "SCIF_RXD", "SCIF_TXD";
	};

	sci0_pins: sci0 {
		pinmux = <RZG2L_PORT_PINMUX(5, 0, 1)>, /* SCI0_TXD_MOSI_SDA */
				<RZG2L_PORT_PINMUX(5, 1, 1)>; /* SCI0_RXD_MISO_SCL */
	};

	sd0_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(10, 1) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd0_pwr_en";
	};

	sdhi0_emmc_pins: emmc-pins {
		sd0-dat-cmd {
			pins = "SD0DAT0", "SD0DAT1", "SD0DAT2", "SD0DAT3", "SD0DAT4",
					"SD0DAT5", "SD0DAT6", "SD0DAT7", "SD0CMD";
			input-enable;
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};

		sd0-clk {
			pins = "SD0CLK";
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};
	};

	sd1_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(10, 3) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd1_pwr_en";
	};

	sdhi1_pins: sd1 {
		sd1_dat_cmd {
			pins = "SD1DAT0", "SD1DAT1", "SD1DAT2", "SD1DAT3", "SD1CMD";
			input-enable;
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};

		sd1_clk {
			pins = "SD1CLK";
			renesas,output-impedance = <3>;
			slew-rate = <0>;
		};
	};

	rs232_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(4, 7) GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "rs232_pwr_en";
	};

	/* cam_pwr_en turns on 1.2V reg, 1.8V_CAM supply and 3.3V_CAM supply. */
	/* Schematic on SOM shows this being PB2/CAM0&1_PWR but it's actually using */
	/* P74. And you can trace this from the SOM to the SBC schematic */
	cam_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(7, 4) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam_pwr_en";
	};

	fan_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(10, 4) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "fan_pwr_en";
	};

	i2c0_pins: i2c0 {
		pinmux = <RZG2L_PORT_PINMUX(3, 0, 1)>, /* I2C0_SDA */
				<RZG2L_PORT_PINMUX(3, 1, 1)>; /* I2C0_SCL */
	};

	i2c1_pins: i2c1 {
		pinmux = <RZG2L_PORT_PINMUX(3, 2, 1)>, /* I2C1_SDA */
				<RZG2L_PORT_PINMUX(3, 3, 1)>; /* I2C1_SCL */
	};

	i2c2_pins: i2c2 {
		pinmux = <RZG2L_PORT_PINMUX(3, 4, 1)>, /* I2C2_SDA */
				<RZG2L_PORT_PINMUX(3, 5, 1)>; /* I2C2_SCL */
	};

	i2c3_pins: i2c3 {
		pinmux = <RZG2L_PORT_PINMUX(3, 6, 1)>, /* I2C3_SDA */
				<RZG2L_PORT_PINMUX(3, 7, 1)>; /* I2C3_SCL */
	};

	i2c5_pins: i2c5 {
		pinmux = <RZG2L_PORT_PINMUX(4, 2, 1)>, /* I2C5_SDA */
				<RZG2L_PORT_PINMUX(4, 3, 1)>; /* I2C5_SCL */
	};

	i2c6_pins: i2c6 {
		pinmux = <RZG2L_PORT_PINMUX(4, 4, 1)>, /* I2C6_SDA */
				<RZG2L_PORT_PINMUX(4, 5, 1)>; /* I2C6_SCL */
	};

	i2c8_pins: i2c8 {
		pinmux = <RZG2L_PORT_PINMUX(0, 6, 1)>, /* I2C8_SDA */
				<RZG2L_PORT_PINMUX(0, 7, 1)>; /* I2C8_SCL */
	};

	usb30_pins: usb30 {
		ovc {
			pinmux = <RZG2L_PORT_PINMUX(6, 1, 14)>; /* OVC */
		};

		vbus {
			pinmux = <RZG2L_PORT_PINMUX(6, 0, 14)>; /* VBUS */
		};
	};

	usb20_pins: usb20 {
		ovc {
			pinmux =  <RZG2L_PORT_PINMUX(9, 6, 14)>; /* OVC */
		};

		vbus {
			pinmux = <RZG2L_PORT_PINMUX(9, 5, 14)>; /* VBUS */
		};
	};

	i3c_pins: i3c {
		pinmux = <RZG2L_PORT_PINMUX(2, 0,0 )>, /* GPIO */
				<RZG2L_PORT_PINMUX(2, 1,0)>; /* GPIO0 */
	};

	sound_pins: sound {
		pinmux = <RZG2L_PORT_PINMUX(1, 2, 7)>, /* SSI3_SCK */
				<RZG2L_PORT_PINMUX(1, 3, 7)>, /* SSI3_WS */
				<RZG2L_PORT_PINMUX(0, 4, 7)>, /* SSI3_SDATA */
				<RZG2L_PORT_PINMUX(1, 5, 7)>; /* SSI4_SDATA */
	};

	wifi_sdio_pins: wifi {
		wifi_sdio_data_pins {
			pinmux = <RZG2L_PORT_PINMUX(11, 1, 1)>, //SD2DAT0
				<RZG2L_PORT_PINMUX(11, 2, 1)>, //SD2DAT1
				<RZG2L_PORT_PINMUX(11, 3, 1)>, //SD2DAT2
				<RZG2L_PORT_PINMUX(11, 4, 1)>, //SD2DAT3
				<RZG2L_PORT_PINMUX(11, 5, 1)>; //SD2CMD
		};

		wifi_sdio_clk_pin {
			pinmux = <RZG2L_PORT_PINMUX(11, 0, 1)>; //SD2CLK
		};
	};

	bluetooth_pins: bluetooth {
		pinmux = <RZG2L_PORT_PINMUX(5, 4, 1)>, //SCI2_TXD_MOSI_SDA
				<RZG2L_PORT_PINMUX(5, 5, 1)>, //SCI2_RXD_MISO_SCL
				<RZG2L_PORT_PINMUX(5, 6, 4)>, //SCI2_CTS
				<RZG2L_PORT_PINMUX(5, 7, 2)>; //SCI2_CTS_RTS
	};
};

&qextal_clk {
	clock-frequency = <24000000>;
};

&ostm2 {
	status = "okay";
};

&ostm3 {
	status = "okay";
};

&scif {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&sdhi0 {
	pinctrl-0 = <&sdhi0_emmc_pins>;
	pinctrl-1 = <&sdhi0_emmc_pins>;
	pinctrl-names = "default", "state_uhs";
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vccq_sdhi0>;
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	mmc-hs200-1_8v;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

&usb3_phy0 {
	status = "okay";
};

&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-1 = <&sdhi1_pins>;
	pinctrl-names = "default", "state_uhs";
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vqmmc_sdhi1>;
	bus-width = <4>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	cd-gpios = <&pinctrl RZG2L_GPIO(9, 4) GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&sdhi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_sdio_pins>;

	vmmc-supply = <&wlan_en_pmic>;
	vqmmc-supply = <&reg_1p8v_sdio>;
	bus-width = <4>;
	keep-power-in-suspend;
	non-removable;

	no-sd;
	no-mmc;

	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	status = "okay";
};

&eth0 {
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;

			// NOTE: these properties were copied from pico-e device tree
			eee-broken-1000t;
			rtl821x,clkout-disable;
		};
	};
};

&eth1 {
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy1: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;

			// NOTE: these properties were copied from pico-e device tree
			eee-broken-1000t;
			rtl821x,clkout-disable;
		};
	};
};

&i2c8 {
	pinctrl-0 = <&i2c8_pins>;
	pinctrl-names = "default";

	status = "okay";

	versa3: versa3@69 {
		compatible = "renesas,5p35023";
		reg = <0x69>;
		#clock-cells = <1>;
		clocks = <&x1_clk>;
		clock-names = "x1";
		otp-burned;
		32kHz-free-running;

		assigned-clocks = <&versa3 0>,
					<&versa3 1>,
					<&versa3 2>,
					<&versa3 3>,
					<&versa3 4>,
					<&versa3 5>;
		assigned-clock-rates =  <100000000>, <100000000>,
					<22579200>, <32768>,
					<24576000>, <24000000>;
		clock-divider-read-only = <1>, <1>, <1>, <1>, <1>;
		clock-flags = <2176>, <2176>, <2176>, <2052>, <2176>, <2048>;
	};
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	status = "okay";

	ap1302_csi20: ap1302_csi20@3c {
		compatible = "onnn,ap1302";
		reg = <0x3c>;

		clock-names = "csi_mclk";
		clocks = <&clk_ext_camera>;

		reset-gpios = <&cam_gpio 8 GPIO_ACTIVE_LOW>;
		power-gpios = <&cam_gpio 0 GPIO_ACTIVE_LOW>;

		port {
			ap1302_to_csi20: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&csi20_in>;
			};
		};

		sensors {
			#address-cells = <1>;
			#size-cells = <0>;

			onnn,model = "onnn,ar1335";

			sensor@0 {
				reg = <0>;
			};
		};
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	status = "okay";

	ap1302_csi21: ap1302_csi21@3d {
		compatible = "onnn,ap1302";
		reg = <0x3d>;

		clock-names = "csi_mclk";
		clocks = <&clk_ext_camera>;

		reset-gpios = <&cam_gpio 9 GPIO_ACTIVE_LOW>;
		power-gpios = <&cam_gpio 1 GPIO_ACTIVE_LOW>;

		port {
			ap1302_to_csi21: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&csi21_in>;
			};
		};

		sensors {
			#address-cells = <1>;
			#size-cells = <0>;

			onnn,model = "onnn,ar1335";

			sensor@0 {
				reg = <0>;
			};
		};
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_pins>;
	pinctrl-names = "default";

	status = "okay";

	mmc5633@30 {
		compatible = "memsic,mmc5633";
		reg = <0x30>;
	};

	sht4x@44 {
		compatible = "sensirion,sht4x";
		reg = <0x44>;
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";

	status = "okay";

	cam_gpio: gpio@20 {
		compatible = "nxp,pcal6416";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"ISP_CCM1_PWR_DIS",
			"ISP_CCM2_PWR_DIS",
			"CCM1_PWR_DIS",
			"CCM2_PWR_DIS",
			"ISP_STBY",
			"ISP_CAM_TRIG",
			"CCM_TRIG",
			"nAUDIO_RESET_1V8",
			"ISP_CCM1_RST",
			"ISP_CCM2_RST",
			"CCM1_RST",
			"CCM2_RST",
			"USB2_SEL",
			"M2_SDIO_RSTn",
			"TP232",
			"RS232_INVALIDn";

		isp-stby-hog {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_HIGH>;
			output-low;
		};
	};

	m2_gpio: gpio@21 {
		compatible = "nxp,pcal6416";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"M2B-CONFIG_0",
			"M2B-CONFIG_1",
			"M2B-CONFIG_2",
			"M2B-CONFIG_3",
			"M2B_CARD_ONOFFn",
			"M2_PD_EN",
			"M2E_BT_WAKE_HOST",
			"M2B_W_DISABLE2n",
			"M2B_WAKE-UP",
			"M2B_RSTn",
			"M2B_DPR",
			"M2B_FLIGHT_MODE",
			"CAN_STDBY",
			"M2B_WAKE_HOST",
			"M2E_BT_ENn",
			"M2E_WLAN_ENn";
	};

	tlv320aic3x: codec@18 {
		#sound-dai-cells = <0>;
		compatible = "ti,tlv320aic3104";
		clocks = <&tlv320_xtal>;
		reg = <0x18>;
		reset-gpios = <&cam_gpio 7 GPIO_ACTIVE_LOW>;
		ai3x-micbias-vg = <1>;
		AVDD-supply = <&reg_audio_3v3>;
		IOVDD-supply = <&reg_audio_1v8>;
		DRVDD-supply = <&reg_audio_3v3>;
		DVDD-supply = <&reg_audio_1v8>;
	};

	secure-eeprom@64 {
		compatible = "atmel,atsha204a";
		reg = <0x64>;
	};
};

&i2c5 {
	pinctrl-0 = <&i2c5_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&i2c6 {
	pinctrl-0 = <&i2c6_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0 {
	vdd-supply = <&VM2M_3V3>;
	status = "okay";
};

&cru0 {
	status = "okay";
};

&csi20 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			csi20_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&ap1302_to_csi20>;
			};
		};
	};
};

&cru1 {
	status = "okay";
};

&csi21 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			csi21_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&ap1302_to_csi21>;
			};
		};
	};
};

&xhci0 {
	pinctrl-0 = <&usb30_pins>;
	pinctrl-names = "default";

	memory-region = <&global_cma>;
	status = "okay";
};

&ohci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ehci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};

&usb20phyrst {
	status = "okay";
};

&usb2_phy0_vbus_otg {
	status = "okay";
};

&usb2_phy0 {
	pinctrl-0 = <&usb20_pins>;
	pinctrl-names = "default";

	vbus-supply = <&usb2_phy0_vbus_otg>;
	status = "okay";
};

&cmtw0 {
	status = "okay";
};

&cmtw1 {
	status = "okay";
};

&rtc_clk {
	clock-frequency = <32768>;
};

&rtc {
	status = "okay";
};

&canfd {
	pinctrl-0 = <&can1_pins>;
	pinctrl-names = "default";
	status = "okay";
	//renesas,no-can-fd; - enables classic CAN
	channel1 {
		status = "okay";
	};
};

&wdt1 {
	status = "okay";
};

&xspi {
	status = "okay";

	flash@0 {
		compatible = "macronix,mx25u12835f", "jedec,spi-nor";
		reg = <0>;
		m25p,fast-read;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
	};
};

&rcar_sound {

	pinctrl-names = "default";
	pinctrl-0 = <&sound_pins>;
	status = "okay";

	/* audio_clkout */
	#clock-cells = <0>;
	clock-frequency = <12288000>; /* should select audio_clka */
	#sound-dai-cells = <0>;

	rcar_sound,dai {
		dai0 {
			playback = <&ssi3>;
			capture  = <&ssi4>;
		};
	};
};

&ssi4 {
	shared-pin;
};
